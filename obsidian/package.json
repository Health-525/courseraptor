{
  "name": "courseraptor-obsidian",
  "version": "0.1.0",
  "description": "CourseRaptor 本地教务 Agent 的 Obsidian 入口：侧栏对话 + 今日日程/待办插入笔记",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
