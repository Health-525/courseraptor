{
  "name": "courseraptor",
  "version": "0.1.2",
  "description": "NJTECH 教务对话式 agent：抢课/课表/成绩/考试，一句话搞定",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "qq": "tsx src/qq/bridge.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "format:check": "biome format src tests",
    "postinstall": "node scripts/patch-tui.mjs",
    "release": "node scripts/release.mjs",
    "publish": "node scripts/publish-release.mjs",
    "server": "node server/update-server.mjs",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "bin": {
    "raptor": "bin/raptor.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Health-525/courseraptor.git"
  },
  "homepage": "https://github.com/Health-525/courseraptor#readme",
  "bugs": {
    "url": "https://github.com/Health-525/courseraptor/issues"
  },
  "keywords": [
    "njtech",
    "agent",
    "cli",
    "deepseek",
    "教务"
  ],
  "author": "jiangshu",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.31",
    "@ai-sdk/tui": "^1.0.84",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "ai": "^7.0.83",
    "docx": "^9.7.1",
    "fontkit": "^2.0.4",
    "mammoth": "^1.12.1",
    "marked": "^18.0.11",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.12",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
