{
  "name": "courseraptor",
  "version": "0.5.0",
  "description": "开源本地教务 Agent：对话直查课表、成绩、考试、通知；也是 Vercel AI SDK + 端口-适配器架构的本地 Agent 工程样例",
  "scripts": {
    "dev": "tsx local/cli/index.ts",
    "start": "tsx local/cli/index.ts",
    "demo": "tsx local/demo/entry.ts",
    "demo:live": "tsx local/demo/entry.ts --live",
    "njtech": "tsx skills/njtech-jwgl/scripts/query.ts",
    "doctor": "node scripts/doctor.mjs",
    "fetch:ocr": "node scripts/fetch-ocr-model.mjs",
    "preview:readme": "node scripts/preview-readme.mjs",
    "qq": "tsx local/qq/bridge.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "postinstall": "node scripts/patch-tui.mjs",
    "release": "node scripts/release.mjs",
    "package:skill": "node scripts/package-skill.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=78 --test-coverage-functions=75 tests/*.test.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=critical"
  },
  "bin": {
    "raptor": "bin/raptor.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Health-525/courseraptor.git"
  },
  "homepage": "https://github.com/Health-525/courseraptor#readme",
  "bugs": {
    "url": "https://github.com/Health-525/courseraptor/issues"
  },
  "keywords": [
    "njtech",
    "agent",
    "cli",
    "deepseek",
    "教务"
  ],
  "author": "jiangshu",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.58",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@ai-sdk/tui": "^1.0.128",
    "@resvg/resvg-js": "^2.6.2",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "ai": "^7.0.83",
    "docx": "^9.8.1",
    "fontkit": "^2.0.4",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.0.14",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
