# DeepSeek API（必填）
DEEPSEEK_API_KEY=

# DeepSeek API 地址（可选，默认官方 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=

# 模型（可选，默认 deepseek-v4-flash；可选 deepseek-v4-pro）
# RAPTOR_MODEL=deepseek-v4-flash

# 南京工业大学教务系统凭证（必填）
JWGL_USERNAME=
JWGL_PASSWORD=

# Firecrawl API Key（可选）：配置后通知附件（PDF/DOC/XLS）解析成文本供 agent 阅读；
# 未配置时附件下载到本地 downloads/ 目录，返回路径
# 免费注册：https://firecrawl.dev（每月 500 次免费额度）
# FIRECRAWL_API_KEY=
