# 正式对话需要模型 API Key；离线演示 npm run demo 不需要配置。
# 默认供应商 DeepSeek（下方 DEEPSEEK_API_KEY）；通义千问/智谱 GLM/Kimi/豆包/
# 混元/MiniMax/阶跃/文心/讯飞/硅基流动/移动云以及自定义 OpenAI 兼容端点，都在
# 网页「设置 → AI 模型」的供应商下拉里选择并填各自的 Key（每家一把、加密
# 分开保存，切换供应商不丢已存的 Key）。
# 推荐首次启动时按引导加密保存，或在终端输入无参数 /key 后安全录入。
# 请勿把 Key 放进聊天消息、截图或 GitHub Issue。
DEEPSEEK_API_KEY=

# DeepSeek API 地址（可选，默认官方 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=

# 模型（可选，默认 deepseek-flash——官方当前主力型号 V4.1-Flash，原生支持图片输入）
# 可选值以「AI 模型」下拉为准（实时拉取 /models），当前另有 deepseek-v4-pro
# （2026-09-14 起由 V4.1-Flash 承接计费）。官方已停用 deepseek-chat / deepseek-reasoner
# 别名（2026-07-24）并退役 deepseek-v4-flash 系列；本地存了旧型号时启动会自动迁移。
# 注意：在网页「AI 模型」里选过一次型号后，本机保存的选择优先于本行。
# RAPTOR_MODEL=deepseek-flash
# 供应商锁定（可选，一般由多用户网关注入；本地 .env 也可指定内置厂商 id，
# 如 qwen / glm / kimi / doubao 等，详见 src/core/providers.ts）
# RAPTOR_PROVIDER_ID=deepseek
# 自定义 OpenAI 兼容端点地址（可选，配合 RAPTOR_PROVIDER_ID=custom 使用；
# 更推荐在网页设置里填写并加密保存）
# RAPTOR_CUSTOM_BASE_URL=

# 终端界面（可选）：默认全屏卡片 UI（@ai-sdk/tui）；
# 设为 1 改用行内渲染器——输出顺着命令行往下滚，滚轮/选中复制可用
# RAPTOR_TUI_INLINE=1

# 待办到期提醒（可选）：待办进入「距到期 ≤ 7 天」窗口后每天提醒一次
# （Windows 桌面通知 + QQ 推送，QQ 桥在线时生效；应用需在运行中）
# 设为 1 关闭
# RAPTOR_NO_TODO_REMINDERS=1

# 教务系统凭证（可选）：留空则首次启动 raptor 时引导录入
# （AES-256-GCM 加密保存到本机 credentials.enc，不明文落盘）。
# 配哪个学校的账号由 RAPTOR_SCHOOL / 设置页「学校」决定，换学校记得换成本校账号
# JWGL_USERNAME=
# JWGL_PASSWORD=

# 学校适配器（可选）：njtech（默认）| hebau | custom（其他学校/手动课表）。
# 不设时依次取：设置页保存的学校（加密凭证，每人一份）→ njtech；
# 未知值启动即报错，绝不静默回退。一般不需要配置——网页设置里选学校即可
# RAPTOR_SCHOOL=njtech

# 统一身份认证（信息门户 / WebVPN）密码（可选）：2026-09 起教务处官网等
# 部门网站限制仅校内 IP 访问，校外抓取教务通知会自动经 vpn.njtech.edu.cn
# 代理，该登录走统一身份认证。它与教务系统密码经常不是同一个：
# 不同时在此配置；留空则先尝试教务密码。登录页有图形验证码，
# 自动识别整体开关为 RAPTOR_DISABLE_CAPTCHA_OCR=1
# CAS_PASSWORD=

# 后台诊断日志级别（可选）：debug|info|warn|error，默认 info。
# 写入 data/raptor.log（超 5MB 自动轮转为 .old）；排障时可临时开 debug
# RAPTOR_LOG_LEVEL=info

# Firecrawl API Key（可选）：公开通知附件的云解析兜底。
# 未配置时仍支持本地 xlsx/docx/pdf 解析；不要向云解析提交私密文件。
# FIRECRAWL_API_KEY=

# QQ 官方机器人（可选，npm run qq 启动）：
# 1. 到 https://q.qq.com 用主号实名注册并创建机器人，拿到 AppID/AppSecret
# 2. 机器人能力勾选「群聊（@消息）」，单聊需用户先添加机器人为好友
# 3. 凭证填这里，或打开网页「设置 → QQ」栏目填写（AES 加密保存，
#    保存后桥自动上线，无需重启；不用改本文件）。两边都配时 .env 优先
# QQBOT_APP_ID=
# QQBOT_APP_SECRET=
# 激活暗号：首次在 QQ 里给机器人发这个暗号即完成授权（openid 落盘 qq-allowlist.json）；
# 同样可在网页「设置 → QQ」里设置，忘了就设个新的，已授权用户不受影响
# QQBOT_PASSCODE=
# 主动推送目标（待办到期提醒等只发给这里的 openid，逗号分隔；不配置则不发推送）。
# openid 见桥启动日志 [auth] 行。白名单里的其他授权用户只可对话，收不到你的提醒
# QQBOT_PUSH_OPENIDS=

# 网页正式端口（默认 3210，占用时会选择空闲端口，以终端提示为准）
# RAPTOR_WEB_PORT=3210
# 演示端口默认 3211；演示不读取 .env，需通过终端环境变量设置 RAPTOR_DEMO_PORT。

# 更新检查（可选）：默认对比 GitHub 仓库 package.json 的版本号，
# 提示有新版后用 /update 拉取；此处可覆盖为自建更新后台地址
# RAPTOR_UPDATE_SERVER=https://updates.你的域名.com

# 匿名使用上报（正式安装包自动启用，本地源码运行默认不上报）：
# 每 24 小时上报一次「随机设备号+版本+平台」，仅用于统计装机量/活跃度，
# 不含学号/账号/对话内容，服务器也无法从设备号反查到人。
# RAPTOR_NO_TELEMETRY=1   # 一键关闭上报
